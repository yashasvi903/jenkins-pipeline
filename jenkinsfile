pipeline{
    agent any

    stages {
        stage ('Checkout') {
            steps {
                git branch: 'jenkins-pipeline', url: 'https://github.com/yashasvi903/jenkins-pipeline.git'

            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Test') {
            steps{
                sh 'echo "No tests yet!"'
            }
        }

        stage('Deploy') {
            steps{
                sh """

                pkill -f index.js || true
                nohup node index.js > app.log 2>&1 &
                """
            }
        }
    }

    post {
        always {
            echo 'pipeline completed'
        }
    }
}

